# Copy to .env.local and fill in. Never commit a filled-in file.
# Every variable is validated at startup by packages/shared/src/env-schemas.ts.

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Storefront scanner
SCANNER_USER_AGENT=
SCANNER_TIMEOUT_MS=15000
SCANNER_MAX_RESPONSE_BYTES=5000000

# Supabase (from the project's API settings). The service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required by the scheduled job endpoints
CRON_SECRET=

# Comma-separated list of admin accounts
ADMIN_EMAILS=

# Optional endpoint that receives health alerts
ALERT_WEBHOOK_URL=
